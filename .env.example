# Set these in Netlify → Site configuration → Environment variables (never commit real values).

# Required for the live AI assistant. Without it the chatbot silently uses its built-in answers.
ANTHROPIC_API_KEY=

# Optional
# ANTHROPIC_MODEL=claude-opus-5     # default; e.g. claude-sonnet-5 or claude-haiku-4-5 for lower cost
# RATE_LIMIT_PER_HOUR=12            # live AI answers per visitor IP per hour
# RATE_LIMIT_PER_DAY=400            # live AI answers across all visitors per day
# GITHUB_TOKEN=                     # raises the GitHub API limit for the get_github_activity tool
